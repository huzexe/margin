# Copy this file to .env and fill in your values. .env is never uploaded to GitHub.

# Gemini API key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=

# Phone access over home Wi-Fi (off unless set to on). Other devices must enter the PIN.
# MARGIN_PHONE_ACCESS=on
# MARGIN_PIN=choose-6-or-more-digits
